# ArchMC Web Viewer Environment Variables

# Use local proxy server to bypass CORS
# Set to 'false' to use direct API calls instead
VITE_USE_PROXY=true

# Local proxy server URL (when VITE_USE_PROXY=true)
VITE_PROXY_BASE=http://localhost:3000

# Direct API configuration (when VITE_USE_PROXY=false)
VITE_API_BASE=https://api.arch.mc/v1
VITE_API_KEY=your_api_key_here

# Optional: Set to 'production' for production builds
VITE_ENV=development
